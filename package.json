{
  "name": "@autocoder/rl-env",
  "version": "0.1.0",
  "description": "RL trading environment for AutoTrader",
  "scripts": {
    "episode": "ts-node -r dotenv/config scripts/run_episode.ts",
    "download": "ts-node -r dotenv/config scripts/download_data.ts",
    "import": "ts-node -r dotenv/config scripts/import_csv.ts",
    "clean-report": "ts-node -r dotenv/config scripts/clean_report.ts",
    "train": "ts-node -r dotenv/config scripts/train.ts",
    "evaluate": "ts-node -r dotenv/config scripts/evaluate.ts",
    "walkforward": "ts-node -r dotenv/config scripts/walkforward.ts",
    "benchmark": "ts-node -r dotenv/config scripts/benchmark.ts",
    "train-ppo": "ts-node -r dotenv/config scripts/train_ppo.ts",
    "evaluate-ppo": "ts-node -r dotenv/config scripts/evaluate_ppo.ts",
    "mcp": "ts-node -r dotenv/config src/mcp/server.ts",
    "play": "ts-node -r dotenv/config scripts/play_as_model.ts",
    "test": "jest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "build": "tsc"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@prisma/client": "^5.10.0",
    "dotenv": "^16.4.5",
    "node-fetch": "^2.7.0",
    "openai": "^4.29.0",
    "technicalindicators": "^3.1.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "@types/node-fetch": "^2.6.11",
    "jest": "^29.7.0",
    "prisma": "^5.10.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
